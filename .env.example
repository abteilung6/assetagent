DATABASE_URL=postgres://assetagent:assetagent@localhost:5432/assetagent?sslmode=disable
API_ADDR=:8080

APP_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_HOURS=336
SESSION_ABSOLUTE_HOURS=720

# First Google login attaches existing rows to that user’s household (local only)
AUTH_CLAIM_EXISTING_DATA=false

# Console (console/.env.local or export before npm run dev):
# VITE_API_BASE_URL=http://localhost:8080

# LLM providers: comma-separated allowlist (ollama, openrouter)
LLM_DEFAULT_PROVIDER=ollama
LLM_PROVIDERS=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenRouter (optional; enable by adding openrouter to LLM_PROVIDERS)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_MODEL_ALLOWLIST=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=assetagent

# Langfuse observability (optional — run `make langfuse-up` first; wired in C42)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
LANGFUSE_TRACE_DETAIL=aggregates
