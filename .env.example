DATABASE_URL=postgres://assetagent:assetagent@localhost:5432/assetagent?sslmode=disable
API_ADDR=:8080

# LLM providers: comma-separated allowlist (ollama, openrouter)
LLM_DEFAULT_PROVIDER=ollama
LLM_PROVIDERS=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenRouter (optional; enable by adding openrouter to LLM_PROVIDERS)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_MODEL_ALLOWLIST=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=assetagent

# Langfuse observability (optional — run `make langfuse-up` first; wired in C42)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
LANGFUSE_TRACE_DETAIL=aggregates
