# Langfuse stack configuration (copy to .env.langfuse — gitignored).
# Used by: docker compose -f docker-compose.langfuse.yml --env-file .env.langfuse
#
# Dev defaults below are fine for local use. For anything beyond localhost, regenerate:
#   openssl rand -base64 32   # NEXTAUTH_SECRET
#   openssl rand -base64 16   # SALT
#   openssl rand -hex 32      # ENCRYPTION_KEY

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-me

POSTGRES_USER=postgres
POSTGRES_PASSWORD=langfuse_dev_postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:langfuse_dev_postgres@langfuse-postgres:5432/postgres

SALT=dev-salt-change-me
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=langfuse_dev_clickhouse

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=langfuse_dev_minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=langfuse_dev_minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=langfuse_dev_minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=langfuse_dev_minio

REDIS_AUTH=langfuse_dev_redis

TELEMETRY_ENABLED=false

# Seed org/project/user on first boot (only when Langfuse DB is empty).
# LANGFUSE_INIT_ORG_ID and LANGFUSE_INIT_PROJECT_ID are required — without them all INIT_* vars are ignored.
# Copy PUBLIC_KEY and SECRET_KEY into the main .env for assetagent (C42).
LANGFUSE_INIT_ORG_ID=assetagent-local
LANGFUSE_INIT_ORG_NAME=assetagent-local
LANGFUSE_INIT_PROJECT_ID=assetagent
LANGFUSE_INIT_PROJECT_NAME=assetagent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-assetagent-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-assetagent-dev
LANGFUSE_INIT_USER_EMAIL=admin@assetagent.dev
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=assetagent-dev
